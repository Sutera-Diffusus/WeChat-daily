{
  "name": "wei-daily-desktop",
  "private": true,
  "version": "0.1.4",
  "description": "微语 Tauri 2 桌面封装",
  "scripts": {
    "icons": "node scripts\\sync-brand.mjs && ..\\.venv\\Scripts\\python.exe scripts\\generate-icons.py",
    "sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "dev": "tauri dev",
    "build": "npm run icons && npm run sidecar && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
